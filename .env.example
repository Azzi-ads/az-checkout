# Backend (Supabase) — copie para as Environment Variables do Vercel.
# A anon key é pública (vai no front, protegida pela RLS). NÃO coloque aqui a service_role.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_publica

# Apenas no Vercel (NUNCA no código/commit): usada pelas funções /api do painel do dono.
# SUPABASE_SERVICE_ROLE=sua_service_role_secreta

# ===== Roteamento de gateways PIX =====
# Lista de gateways ativos (separados por vírgula). Hoje o processador real é "bravopay".
GATEWAY_IDS=bravopay
# URL de health/ping de cada gateway: GATEWAY_<ID em maiúsculas>_PING_URL
GATEWAY_BRAVOPAY_PING_URL=https://bravopay.solutions/api/v1/products
# Timeout (ms) do ping e de cada tentativa de fallback (padrão 3000)
GATEWAY_TIMEOUT_MS=3000
